{
  "name": "@roryscot/metamap",
  "version": "0.3.0",
  "description": "Language-neutral authority and structural correspondence graph",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "metamap": "dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "relation-packs",
    "examples",
    "README.md",
    "ARCHITECTURE.md",
    "VIABILITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "validate:example": "npm run build && node dist/cli.js validate examples/example-authority-graph.json",
    "example:generate": "npm run build && node dist/cli.js generate examples/workspace/metamap.config.json --no-cache",
    "example:check": "npm run build && node dist/cli.js check examples/workspace/metamap.config.json --no-cache",
    "example:compile": "npm run build && node dist/cli.js compile examples/example-authority-graph.json examples/example-viability-policy.json examples/example-generation.json --context examples/example-context.json --as-of 2026-09-02T00:00:00.000Z && prettier --write examples/example-generation.json",
    "example:research": "npm run build && node dist/cli.js generate examples/research/metamap.config.json --no-cache && node dist/cli.js compile examples/research/generated/graph.json examples/research/viability-policy.json examples/research/generated/generation.json --relation-pack relation-packs/research.json --as-of 2026-09-02T00:00:00.000Z && prettier --write examples/research/generated",
    "prepare": "npm run build"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.37",
    "prettier": "^3.6.2",
    "vitest": "^3.2.4"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./model": {
      "import": "./dist/model.js",
      "types": "./dist/model.d.ts"
    },
    "./legacy": {
      "import": "./dist/adapters/source-of-truth.js",
      "types": "./dist/adapters/source-of-truth.d.ts"
    },
    "./viability": {
      "import": "./dist/viability.js",
      "types": "./dist/viability.d.ts"
    },
    "./viability-model": {
      "import": "./dist/viability-model.js",
      "types": "./dist/viability-model.d.ts"
    },
    "./context": {
      "import": "./dist/context.js",
      "types": "./dist/context.d.ts"
    },
    "./impact": {
      "import": "./dist/impact.js",
      "types": "./dist/impact.d.ts"
    },
    "./constraints": {
      "import": "./dist/constraints.js",
      "types": "./dist/constraints.d.ts"
    },
    "./activation": {
      "import": "./dist/activation.js",
      "types": "./dist/activation.d.ts"
    },
    "./adapter-registry": {
      "import": "./dist/adapters/registry.js",
      "types": "./dist/adapters/registry.d.ts"
    },
    "./metamap-shard": {
      "import": "./dist/adapters/metamap-shard.js",
      "types": "./dist/adapters/metamap-shard.d.ts"
    },
    "./relation-pack": {
      "import": "./dist/relation-pack.js",
      "types": "./dist/relation-pack.d.ts"
    },
    "./schemas/metamap-graph.schema.json": "./schemas/metamap-graph.schema.json",
    "./schemas/metamap-config.schema.json": "./schemas/metamap-config.schema.json",
    "./schemas/relation-pack.schema.json": "./schemas/relation-pack.schema.json",
    "./schemas/metamap-viability.schema.json": "./schemas/metamap-viability.schema.json",
    "./schemas/metamap-generation.schema.json": "./schemas/metamap-generation.schema.json",
    "./relation-packs/core.json": "./relation-packs/core.json",
    "./relation-packs/research.json": "./relation-packs/research.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roryscot/metamap.git"
  },
  "bugs": {
    "url": "https://github.com/roryscot/metamap/issues"
  },
  "homepage": "https://github.com/roryscot/metamap#readme",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "architecture",
    "authority",
    "graph",
    "schema",
    "source-of-truth"
  ]
}
