{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/roryscot/metamap/main/schemas/metamap-change-proposal.schema.json",
  "title": "Unapproved exact consumer change proposal 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "digest",
    "consumer",
    "environment",
    "intent",
    "proposer",
    "trust",
    "baseline",
    "candidate",
    "artifacts",
    "requirements"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "consumer": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "enum": ["deploy", "rollback"]
    },
    "proposer": {
      "type": "string",
      "minLength": 1
    },
    "trust": {
      "$ref": "https://raw.githubusercontent.com/roryscot/metamap/main/schemas/metamap-governance.schema.json#/$defs/trust"
    },
    "baseline": {
      "anyOf": [
        {
          "$ref": "https://raw.githubusercontent.com/roryscot/metamap/main/schemas/metamap-governance.schema.json#/$defs/baseline"
        },
        {
          "type": "null"
        }
      ]
    },
    "candidate": {
      "$ref": "https://raw.githubusercontent.com/roryscot/metamap/main/schemas/metamap-replay-v3.schema.json"
    },
    "artifacts": {
      "$ref": "https://raw.githubusercontent.com/roryscot/metamap/main/schemas/metamap-artifact-manifest.schema.json"
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "https://raw.githubusercontent.com/roryscot/metamap/main/schemas/metamap-governance.schema.json#/$defs/requirement"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
