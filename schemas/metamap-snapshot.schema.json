{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/roryscot/metamap/main/schemas/metamap-snapshot.schema.json",
  "title": "Existing Metamap discovery snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "graphId",
    "graphRevision",
    "graphDigest",
    "configDigest",
    "sources",
    "counts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "graphId": {
      "$ref": "#/$defs/identifier"
    },
    "graphRevision": {
      "type": "string",
      "minLength": 1
    },
    "graphDigest": {
      "$ref": "#/$defs/digest"
    },
    "configDigest": {
      "$ref": "#/$defs/digest"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "adapter", "adapterVersion", "inputs"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "adapter": {
            "type": "string",
            "minLength": 1
          },
          "adapterVersion": {
            "type": "string",
            "minLength": 1
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "digest"],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "digest": {
                  "$ref": "#/$defs/digest"
                }
              }
            }
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entities", "mappings", "authorities"],
      "properties": {
        "entities": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mappings": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "authorities": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
