{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/roryscot/metamap/main/schemas/metamap-repair.schema.json",
  "title": "Bounded read-only Metamap repair contracts 1.0",
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "fact"],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "fact": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "edit": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "semanticCost", "kind", "mapping"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "semanticCost": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "kind": {
              "const": "restore-mapping"
            },
            "mapping": {
              "$ref": "https://raw.githubusercontent.com/roryscot/metamap/main/schemas/metamap-graph/v2.schema.json#/$defs/mapping"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "semanticCost",
            "kind",
            "mappingIndex",
            "expectedDigest",
            "target"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "semanticCost": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "kind": {
              "const": "select-target"
            },
            "mappingIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 999999
            },
            "expectedDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "target": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "semanticCost",
            "kind",
            "mappingIndex",
            "expectedDigest",
            "keepIndex",
            "keepDigest"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "semanticCost": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "kind": {
              "const": "remove-duplicate"
            },
            "mappingIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 999999
            },
            "expectedDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "keepIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 999999
            },
            "keepDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "semanticCost", "kind", "declaration"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "semanticCost": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "kind": {
              "const": "supply-declaration"
            },
            "declaration": {
              "allOf": [
                {
                  "$ref": "https://raw.githubusercontent.com/roryscot/metamap/v0.2.0/schemas/metamap-viability.schema.json#/$defs/mappingDeclaration"
                },
                {
                  "type": "object",
                  "required": ["mapping"],
                  "properties": {
                    "mapping": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumCandidates",
        "maximumEdits",
        "maximumDerivationDepth",
        "maximumElapsedMilliseconds"
      ],
      "properties": {
        "maximumCandidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "maximumEdits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "maximumDerivationDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "maximumElapsedMilliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "digest",
        "baseline",
        "consumer",
        "requiredProjections",
        "allowedFacts",
        "protectedFacts",
        "edits",
        "bounds",
        "ranking"
      ],
      "properties": {
        "$schema": {
          "type": "string",
          "format": "uri-reference"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "baseline": {
          "$ref": "https://raw.githubusercontent.com/roryscot/metamap/main/schemas/metamap-replay-v3.schema.json"
        },
        "consumer": {
          "type": "string",
          "minLength": 1
        },
        "requiredProjections": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "allowedFacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scope"
          },
          "uniqueItems": true
        },
        "protectedFacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scope"
          },
          "uniqueItems": true
        },
        "edits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edit"
          },
          "maxItems": 64
        },
        "bounds": {
          "$ref": "#/$defs/bounds"
        },
        "ranking": {
          "const": ["edited-records", "semantic-cost", "proposal-id"]
        }
      }
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graph", "policy", "bindingUpdates"],
      "properties": {
        "graph": {
          "type": "object",
          "additionalProperties": false,
          "required": ["beforeDigest", "afterDigest", "value"],
          "properties": {
            "beforeDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "afterDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "value": {
              "$ref": "https://raw.githubusercontent.com/roryscot/metamap/main/schemas/metamap-graph/v2.schema.json"
            }
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["beforeDigest", "afterDigest", "value"],
          "properties": {
            "beforeDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "afterDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "value": {
              "$ref": "https://raw.githubusercontent.com/roryscot/metamap/main/schemas/metamap-viability-v2.schema.json"
            }
          }
        },
        "bindingUpdates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["subject", "fact", "before", "after"],
            "properties": {
              "subject": {
                "type": "string",
                "minLength": 1
              },
              "fact": {
                "const": "policy.graph"
              },
              "before": {
                "$ref": "https://raw.githubusercontent.com/roryscot/metamap/v0.2.0/schemas/metamap-viability.schema.json#/$defs/graphBinding"
              },
              "after": {
                "$ref": "https://raw.githubusercontent.com/roryscot/metamap/v0.2.0/schemas/metamap-viability.schema.json#/$defs/graphBinding"
              }
            }
          },
          "maxItems": 1
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "edit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "attempt": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "digest", "edits", "status", "issues", "request"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "edits": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true
            },
            "status": {
              "const": "blocked"
            },
            "issues": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/issue"
              },
              "minItems": 1
            },
            "request": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "digest"],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "digest",
            "edits",
            "status",
            "patch",
            "candidate",
            "comparison",
            "admitted",
            "viable",
            "authorization",
            "requirements",
            "rank",
            "remainingFailures",
            "request"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "edits": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true
            },
            "status": {
              "const": "evaluated"
            },
            "patch": {
              "$ref": "#/$defs/patch"
            },
            "candidate": {
              "$ref": "https://raw.githubusercontent.com/roryscot/metamap/main/schemas/metamap-replay-v3.schema.json"
            },
            "comparison": {
              "$ref": "https://raw.githubusercontent.com/roryscot/metamap/main/schemas/metamap-counterfactual-v3.schema.json"
            },
            "admitted": {
              "type": "boolean"
            },
            "viable": {
              "type": "boolean"
            },
            "authorization": {
              "enum": ["approval-required", "unavailable"]
            },
            "requirements": {
              "type": "array",
              "items": {
                "$ref": "https://raw.githubusercontent.com/roryscot/metamap/main/schemas/metamap-governance.schema.json#/$defs/requirement"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "rank": {
              "type": "object",
              "additionalProperties": false,
              "required": ["editedRecords", "semanticCost"],
              "properties": {
                "editedRecords": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8
                },
                "semanticCost": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            },
            "remainingFailures": {
              "$ref": "https://raw.githubusercontent.com/roryscot/metamap/main/schemas/metamap-counterfactual-v3.schema.json#/properties/issues/properties/introduced"
            },
            "request": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "digest"],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              }
            }
          }
        }
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalCombinations",
        "attempted",
        "unexamined",
        "excludedByEditLimit",
        "elapsedMilliseconds",
        "stopReasons"
      ],
      "properties": {
        "totalCombinations": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "attempted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "unexamined": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "excludedByEditLimit": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "elapsedMilliseconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "stopReasons": {
          "type": "array",
          "items": {
            "enum": [
              "candidate-limit",
              "edit-limit",
              "elapsed-limit",
              "cancelled"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "digest",
        "request",
        "status",
        "applied",
        "space",
        "attempts",
        "proposals",
        "coverage",
        "minimality"
      ],
      "properties": {
        "$schema": {
          "type": "string",
          "format": "uri-reference"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "request": {
          "$ref": "#/$defs/request"
        },
        "status": {
          "enum": ["complete", "incomplete"]
        },
        "applied": {
          "const": false
        },
        "space": {
          "const": "nonempty-subsets-of-supplied-edits"
        },
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attempt"
          },
          "maxItems": 1000
        },
        "proposals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "minimality": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "proposal", "global"],
          "properties": {
            "status": {
              "enum": ["within-finite-space", "not-established"]
            },
            "proposal": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "global": {
              "const": false
            }
          }
        }
      }
    }
  }
}
