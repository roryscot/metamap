{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/roryscot/metamap/main/schemas/relation-pack-v2.schema.json",
  "title": "Metamap executable relation pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "relations", "laws"],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "schemaVersion": {
      "const": "2.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "imports": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "digest"],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "laws": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "operation",
          "operands",
          "resultRelation",
          "handling"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "operation": {
            "enum": ["reverse", "chain"]
          },
          "operands": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "$ref": "#/$defs/relationIdentifier"
            }
          },
          "resultRelation": {
            "$ref": "#/$defs/relationIdentifier"
          },
          "conditions": {
            "$ref": "#/$defs/conditions"
          },
          "handling": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lossiness", "uncertainty", "authority"],
            "properties": {
              "lossiness": {
                "const": "conservative"
              },
              "uncertainty": {
                "const": "conservative"
              },
              "authority": {
                "const": "none"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "operation": {
                  "const": "reverse"
                }
              },
              "required": ["operation"]
            },
            "then": {
              "properties": {
                "operands": {
                  "minItems": 1,
                  "maxItems": 1,
                  "type": "array"
                },
                "conditions": {
                  "properties": {
                    "middleKinds": false
                  },
                  "type": "object"
                }
              }
            },
            "else": {
              "properties": {
                "operands": {
                  "minItems": 2,
                  "maxItems": 2,
                  "type": "array"
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "cyclePolicy"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*:[a-z][a-z0-9._-]*$"
        },
        "description": {
          "type": "string"
        },
        "sourceKinds": {
          "$ref": "#/$defs/kinds"
        },
        "targetKinds": {
          "$ref": "#/$defs/kinds"
        },
        "cardinalities": {
          "type": "array",
          "items": {
            "enum": ["one-to-one", "one-to-many", "many-to-one", "many-to-many"]
          },
          "uniqueItems": true
        },
        "cyclePolicy": {
          "enum": ["allow", "forbid"]
        },
        "transitive": {
          "type": "boolean"
        },
        "symmetric": {
          "type": "boolean"
        },
        "inverse": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*:[a-z][a-z0-9._-]*$"
        },
        "composesWith": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]*:[a-z][a-z0-9._-]*$"
          },
          "uniqueItems": true
        },
        "impactDirection": {
          "enum": ["source-to-target", "target-to-source", "both", "none"]
        },
        "disjointWith": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]*:[a-z][a-z0-9._-]*$"
          }
        }
      }
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "jsonPrimitive": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ]
    },
    "contextExpression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "operator", "value"],
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1
            },
            "operator": {
              "enum": ["equals", "not-equals"]
            },
            "value": {
              "$ref": "#/$defs/jsonPrimitive"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "operator", "values"],
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1
            },
            "operator": {
              "enum": ["in", "not-in"]
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/jsonPrimitive"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "operator"],
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1
            },
            "operator": {
              "const": "exists"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["all"],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/contextExpression"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any"],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/contextExpression"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["not"],
          "properties": {
            "not": {
              "$ref": "#/$defs/contextExpression"
            }
          }
        }
      ]
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "context": {
          "$ref": "#/$defs/contextExpression"
        },
        "sourceKinds": {
          "$ref": "#/$defs/kinds"
        },
        "middleKinds": {
          "$ref": "#/$defs/kinds"
        },
        "targetKinds": {
          "$ref": "#/$defs/kinds"
        }
      }
    },
    "relationIdentifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*:[a-z][a-z0-9._-]*$"
    }
  },
  "description": "Closed, explicitly requested binary relation laws with exact imported relation definitions."
}
