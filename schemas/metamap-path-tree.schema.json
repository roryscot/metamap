{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/roryscot/metamap/main/schemas/metamap-path-tree.schema.json",
  "title": "Metamap nested path tree",
  "description": "A content-addressed nested path map compiled from a static Metamap projection. Every node stores its path template in `_`. A `$` occupant is present only when a projected subject owns that exact path.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "digest",
    "projection",
    "spec",
    "attribute",
    "delimiter",
    "params",
    "tree"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schemaVersion": { "const": "1.0.0" },
    "id": { "$ref": "#/$defs/identifier" },
    "digest": { "$ref": "#/$defs/digest" },
    "projection": { "$ref": "#/$defs/binding" },
    "spec": { "$ref": "#/$defs/binding" },
    "attribute": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "delimiter": { "enum": ["/", "--", "."] },
    "params": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(:[A-Za-z][A-Za-z0-9_]*|\\*[A-Za-z][A-Za-z0-9_]*\\??)$"
      }
    },
    "tree": { "$ref": "#/$defs/node" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        { "$ref": "#/$defs/jsonObject" }
      ]
    },
    "jsonObject": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/jsonValue" }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri"],
      "properties": {
        "uri": { "$ref": "#/$defs/identifier" },
        "mediaType": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "minLength": 1 }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "schema": { "$ref": "#/$defs/identifier" },
        "locators": { "type": "array", "items": { "$ref": "#/$defs/locator" } },
        "attributes": { "$ref": "#/$defs/jsonObject" }
      }
    },
    "occupant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "slots"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "slots": { "$ref": "#/$defs/jsonObject" }
      }
    },
    "node": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["_"],
      "properties": {
        "_": { "type": "string", "minLength": 1 },
        "$": { "$ref": "#/$defs/occupant" }
      },
      "patternProperties": {
        "^(?!_|\\$).+$": { "$ref": "#/$defs/node" }
      }
    }
  }
}
