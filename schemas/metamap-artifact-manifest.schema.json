{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/roryscot/metamap/main/schemas/metamap-artifact-manifest.schema.json",
  "title": "Exact generated consumer byte manifest 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "digest",
    "consumer",
    "environment",
    "replay",
    "files"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "consumer": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "replay": {
      "$ref": "https://raw.githubusercontent.com/roryscot/metamap/main/schemas/metamap-governance.schema.json#/$defs/binding"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "https://raw.githubusercontent.com/roryscot/metamap/main/schemas/metamap-governance.schema.json#/$defs/file"
      },
      "minItems": 1
    }
  }
}
