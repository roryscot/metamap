{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/roryscot/metamap/v0.2.0/schemas/metamap-generation.schema.json",
  "title": "Metamap viable generation",
  "description": "An immutable, content-addressed result of compiling a graph under a viability policy and explicit context.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "digest",
    "evaluatedAt",
    "graph",
    "policy",
    "context",
    "activeMappings",
    "inactiveMappings",
    "evidence",
    "waiversApplied"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schemaVersion": { "const": "1.0.0" },
    "id": { "$ref": "#/$defs/identifier" },
    "digest": { "$ref": "#/$defs/digest" },
    "evaluatedAt": { "type": "string", "format": "date-time" },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "revision": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/contextValue" }
    },
    "activeMappings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "inactiveMappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "reason": { "enum": ["when-not-satisfied", "inhibited"] }
        }
      }
    },
    "evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "waiversApplied": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "contextValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "null" },
              { "type": "boolean" },
              { "type": "number" },
              { "type": "string" }
            ]
          }
        }
      ]
    }
  }
}
